# Read `man 5 sway` for a complete reference.

set $mod Mod4
set $term ghostty +new-window
set $menu fuzzel

input type:keyboard {
    xkb_layout us
    xkb_numlock enabled
}

exec "systemctl --user import-environment {,WAYLAND_}DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_TYPE; systemctl --user start sway-session.target"
exec swaymsg -t subscribe '["shutdown"]' && systemctl --user stop sway-session.target

exec_always "$HOME"/.local/bin/gsettings-gtk

# waybar runs via sway-session.target
bar {
    mode invisible
}

include theme
include windowrules
include keybindings
include /etc/sway/config.d/*
include ~/.config/sway/$(hostname)/*
