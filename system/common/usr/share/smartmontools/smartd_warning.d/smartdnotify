#!/bin/sh
# Notify every logged-in user: dispatch into their user manager

loginctl --no-legend list-users 2>/dev/null | while read -r _ user; do
  systemd-run --machine="$user"@.host --user --quiet notify-send "S.M.A.R.T Error ($SMARTD_FAILTYPE)" "$SMARTD_MESSAGE" --icon=dialog-warning -u critical
done
