# Socket-activation listener for the docker MCP gateway (host opencode, OpenShell sandboxes).
[Unit]
Description=docker mcp gateway listener (docker0-bound)

[Socket]
# docker0, not loopback: the gateway rejects non-loopback Host headers (e.g. host.openshell.internal) while it listens on loopback.
ListenStream=172.17.0.1:8811
# docker0 may not carry its address yet when this unit starts.
FreeBind=yes
Service=docker-mcp-gateway-proxy.service

[Install]
WantedBy=sockets.target
