#!/usr/bin/env bash
# Provides the bearer token, then runs the docker MCP gateway.
set -euo pipefail

TOKEN_FILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/docker-mcp-gateway/token"

# Exit 78 (RestartPreventExitStatus): no token.
if [[ ! -s "$TOKEN_FILE" ]]; then
  "$(dirname "$(readlink -f "$0")")/docker-mcp-token" || exit 78
fi
MCP_GATEWAY_AUTH_TOKEN="$(<"$TOKEN_FILE")"
export MCP_GATEWAY_AUTH_TOKEN
exec /usr/bin/docker mcp gateway run --transport streaming --host 172.17.0.1 --port 18811 --profile dev-tools
