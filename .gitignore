# --- Nix (den layout) --------------------------------------------------------
# Mutable files are mkOutOfStoreSymlink targets living in the repo (tracked);
# nothing to ignore for those. Build artefacts and locally-decrypted secrets
# stay out. secrets.yaml (the sops store) IS tracked.
result
result-*
*.qcow2
secrets/decrypted/

# NOTE: the stow-era rules below remain until the stow/ tree is deleted in
# Section 11.6 - they still protect secret/cache files inside the live stow
# packages. They are removed together with the stow directories.

