#!/usr/bin/env bash
# Reconcile the per-repo OpenCode OpenShell sandbox from dotfiles state (`oc` is the user entry). See openshell/README.md.
#
# Usage:
#   opencode-sandbox [dir]             reconcile the sandbox for dir (default: $PWD; refuses $HOME and /)
#   opencode-sandbox --rebuild [dir]   same, forcing an image rebuild first
#   opencode-sandbox --print <dir>     print "<name>\t<workdir>" and exit (no gateway calls)
#   opencode-sandbox --setup           import or update every profile and create missing providers; run once after stowing and after editing a profile

set -euo pipefail

OPENSHELL_CFG="${XDG_CONFIG_HOME:-$HOME/.config}/openshell"
# A new tag makes the next launch build the image; sandboxes follow via the layout marker.
IMAGE="${OPENSHELL_OC_IMAGE:-openshell-opencode:v2}"
IMAGE_DIR="$OPENSHELL_CFG/images/opencode"
PROFILES_DIR="$OPENSHELL_CFG/profiles"
POLICY_FILE="$OPENSHELL_CFG/policies/opencode.yaml"
STAGE_ROOT="${TMPDIR:-/tmp}/opencode"
WORK_DIR=""

# True if the pass entry exists; tests the .gpg file, never decrypts.
pass_has() { [[ -f "${PASSWORD_STORE_DIR:-$HOME/.password-store}/openshell/$1.gpg" ]]; }

log() { printf '==> %s\n' "$*"; }

cleanup() { [[ -z "$WORK_DIR" ]] || rm -rf -- "$WORK_DIR"; }
trap cleanup EXIT
work_dir() {
  if [[ -z "$WORK_DIR" ]]; then
    # shellcheck disable=SC2174  # only the leaf, and only when created: an existing root keeps its mode
    mkdir -p -m 700 -- "$STAGE_ROOT"
    WORK_DIR="$(mktemp -d "${STAGE_ROOT}/work.XXXXXX")"
  fi
}

# Lightweight parsing: profiles must keep `id:` on its own line and an inline `env_vars: [..]`.
profile_id() { awk '/^id:/{print $2; exit}' "$1"; }
profile_vars() { sed -n 's/.*env_vars: *\[\(.*\)\].*/\1/p' "$1" | tr -d ' ' | tr ',' '\n' | grep -v '^$' || true; }

REBUILD=0
PRINT_ONLY=0
SETUP=0
case "${1:-}" in
--rebuild)
  REBUILD=1
  shift
  ;;
--setup)
  SETUP=1
  shift
  (($# == 0)) || {
    echo "usage: $0 --setup" >&2
    exit 1
  }
  ;;
--print)
  PRINT_ONLY=1
  shift
  ;;
esac
REPO_DIR="${1:-$PWD}"

if ((SETUP)); then
  : # profiles only: no repo dir, no sandbox name
elif [[ -n "$REPO_DIR" ]]; then
  REPO_DIR="$(realpath -- "$REPO_DIR")"
  [[ -d "$REPO_DIR" ]] || {
    echo "ERROR: not a directory: $REPO_DIR" >&2
    exit 1
  }
  if ((PRINT_ONLY)); then :; else
    [[ "$REPO_DIR" != "$HOME" && "$REPO_DIR" != "/" ]] || {
      echo "ERROR: refusing to sandbox '${REPO_DIR}' (run from a repo directory)" >&2
      exit 1
    }
  fi
  REPO_BASE="$(basename -- "$REPO_DIR")"
  REPO_BASE="$(printf '%s' "$REPO_BASE" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9-' '-' | sed -E 's/^-+//; s/-+$//')"
  REPO_BASE="$(printf '%s' "${REPO_BASE:0:9}" | sed -E 's/^-+//; s/-+$//')"
  [[ -n "$REPO_BASE" ]] || REPO_BASE="repo"
  REPO_HASH="$(printf '%s' "$REPO_DIR" | sha1sum | cut -c1-5)"
  SANDBOX_NAME="oc-${REPO_BASE}-${REPO_HASH}"
  REPO_TARGET="/sandbox/${REPO_BASE}"
  STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/oc-sync/${SANDBOX_NAME}.env"
elif ((PRINT_ONLY)); then
  echo "usage: $0 --print <repo-dir>" >&2
  exit 1
fi

if ((PRINT_ONLY)); then
  printf '%s\t%s\n' "$SANDBOX_NAME" "$REPO_TARGET"
  exit 0
fi

command -v openshell >/dev/null || {
  echo "ERROR: openshell CLI not found" >&2
  exit 1
}

mapfile -t PROFILE_FILES < <(find "$PROFILES_DIR" -maxdepth 1 -name '*.yaml' | sort)
((${#PROFILE_FILES[@]} > 0)) || {
  echo "ERROR: no profiles found in ${PROFILES_DIR}" >&2
  exit 1
}

# --setup: lint each profile, import it when the gateway lacks it (import is create-only, so an existing one is updated), then create a missing provider per profile (named after the profile id, credentials from pass entries openshell/<ENV_VAR>).
if ((SETUP)); then
  work_dir
  for profile in "${PROFILE_FILES[@]}"; do
    PROFILE_ID="$(profile_id "$profile")"
    [[ -n "$PROFILE_ID" ]] || {
      echo "ERROR: no 'id:' line in ${profile}" >&2
      exit 1
    }
    openshell profile lint -f "$profile" >/dev/null
    if ! openshell profile describe "$PROFILE_ID" --global >/dev/null 2>&1; then
      log "profile import: ${PROFILE_ID}"
      openshell profile import -f "$profile" --global >/dev/null
    else
      # update needs the stored resource_version: it goes into a copy of the file.
      rv="$(openshell profile export "$PROFILE_ID" --global | sed -n 's/^resource_version: *//p')"
      grep -v '^resource_version:' "$profile" | sed "/^id:/a resource_version: ${rv}" >"$WORK_DIR/profile.yaml"
      log "profile update: ${PROFILE_ID}"
      openshell profile update -f "$WORK_DIR/profile.yaml" --global "$PROFILE_ID" >/dev/null
    fi
    mapfile -t ENV_VARS < <(profile_vars "$profile")
    if ((${#ENV_VARS[@]})) && ! openshell provider get "$PROFILE_ID" >/dev/null 2>&1; then
      # --credential VAR makes the CLI read VAR from its own environment, never argv: the pass value rides `env` for this one command and overrides any VAR already exported here.
      create_env=()
      create_args=()
      for var in "${ENV_VARS[@]}"; do
        if ! pass_has "$var"; then
          echo "ERROR: missing pass entry openshell/${var} (profile ${PROFILE_ID})" >&2
          printf 'Add it with: pass insert openshell/%s\n' "$var" >&2
          exit 1
        fi
        PASS_VAL="$(pass show "openshell/${var}")"
        create_env+=("$var=${PASS_VAL}")
        create_args+=(--credential "$var")
      done
      log "provider create: ${PROFILE_ID}"
      env "${create_env[@]}" openshell provider create --name "$PROFILE_ID" --type "$PROFILE_ID" "${create_args[@]}"
    fi
  done
  log "setup done. A changed profile or policy reaches existing sandboxes when the next oc recreates them"
  exit 0
fi

# 0. Only the MCP gateway listener and its token file are checked: the gateway itself is inactive by design until a sandbox connects, and the token file is written by `docker-mcp-token`.
if command -v systemctl >/dev/null 2>&1; then
  if ! systemctl --user is-active --quiet docker-mcp-gateway.socket; then
    echo "WARNING: docker-mcp-gateway.socket is not listening." >&2
    echo "         MCP servers will be unreachable: systemctl --user enable --now docker-mcp-gateway.socket" >&2
  fi
fi
TOKEN_FILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/docker-mcp-gateway/token"
[[ -s "$TOKEN_FILE" ]] || echo "WARNING: no gateway token; MCP will be refused until you run docker-mcp-token" >&2

# 1. Sandbox image, built when missing.
build_image() {
  local stage
  work_dir
  stage="$WORK_DIR/imgctx"
  mkdir -- "$stage"
  cp "$IMAGE_DIR/Dockerfile" "$IMAGE_DIR/sandbox.jsonc" "$stage/"
  log "image build: ${IMAGE} (context ${IMAGE_DIR}, staged at ${stage})"
  docker build -t "$IMAGE" "$stage"
}

if command -v docker >/dev/null 2>&1; then
  if ((REBUILD)) || ! docker image inspect "$IMAGE" &>/dev/null; then
    build_image
  else
    log "image exists: ${IMAGE}"
  fi
else
  echo "WARNING: docker not found; image build skipped (sandbox create will fail if the image is missing)" >&2
fi

# 2. Sandbox, no mounts. A stopped sandbox is started. Its marker carries the image and a hash of the policy and profiles, so a change to either recreates it here, guarded against unsynced work.
LAYOUT_VERSION="zero-mount-2"
IMAGE_ID="$(timeout 5 docker image inspect -f '{{.Id}}' "$IMAGE" 2>/dev/null || true)"
CONFIG_ID="$(cat "$POLICY_FILE" "${PROFILE_FILES[@]}" | sha256sum | cut -c1-12)"
MARKER="$LAYOUT_VERSION $IMAGE_ID $CONFIG_ID"
sandbox_exec() { openshell sandbox exec "$SANDBOX_NAME" -- "$@" </dev/null; } # stdin is never a terminal
# The sandbox side (POSIX sh) lives in ../lib/oc-sync, reached through the stow symlink, and goes in as the text of sh -c ($0 opencode-sandbox, then the arguments): nothing is installed in the sandbox.
LIB="$(dirname "$(readlink -f "$0")")/../lib/oc-sync"
rsh() {
  local s="$LIB/$1.sh" text
  shift
  text="$(<"$s")" || return
  sandbox_exec sh -c "$text" opencode-sandbox "$@"
}
create_sandbox() {
  local -a args=()
  local id
  for profile in "${PROFILE_FILES[@]}"; do
    id="$(profile_id "$profile")"
    openshell provider get "$id" >/dev/null 2>&1 || {
      echo "ERROR: provider ${id} not found (or the gateway is unreachable): run 'opencode-sandbox --setup'" >&2
      exit 1
    }
    args+=(--provider "$id")
  done
  log "sandbox create: ${SANDBOX_NAME} (repo ${REPO_DIR} -> ${REPO_TARGET})"
  openshell sandbox create --detach --from "$IMAGE" "${args[@]}" --policy "$POLICY_FILE" --name "$SANDBOX_NAME"
  rsh marker "$MARKER"
}
# Unsynced work: the sandbox's tree or HEAD moved past what the last sync recorded; unknown counts as moved.
unsynced() {
  local have
  have="$(rsh unsynced "$REPO_TARGET" 2>/dev/null)" || return 0
  [[ "$have" != "$(sed -n 's/^base_tree=//p' "$STATE_FILE")"$'\n'"$(sed -n 's/^host_head=//p' "$STATE_FILE")" ]]
}
recreate_sandbox() {
  if [[ -f "$STATE_FILE" ]] && unsynced; then
    echo "ERROR: ${SANDBOX_NAME} holds unsynced work; nothing was deleted. Pull it with 'oc-sync pull ${REPO_DIR}', or delete $STATE_FILE to discard it" >&2
    exit 1
  fi
  log "$1: recreating ${SANDBOX_NAME}"
  openshell sandbox delete "$SANDBOX_NAME" >/dev/null
  create_sandbox
}

if SANDBOX_INFO="$(openshell sandbox get "$SANDBOX_NAME" 2>/dev/null)"; then
  log "sandbox exists: ${SANDBOX_NAME}"
  if [[ "$(awk '/Phase:/{print $NF; exit}' <<<"$SANDBOX_INFO")" != Ready ]]; then
    log "sandbox start: ${SANDBOX_NAME}"
    if ! openshell sandbox start "$SANDBOX_NAME" >/dev/null 2>&1; then
      recreate_sandbox "sandbox does not start"
    fi
  fi
  if [[ "$(sandbox_exec cat /sandbox/.oc-layout 2>/dev/null || true)" != "$MARKER" ]]; then
    recreate_sandbox "sandbox layout, image or config changed"
  fi
else
  create_sandbox
fi

log "done. start a session with: oc"
