#!/usr/bin/env bash
# oc-stop [dir]: stop this repo's OpenShell sandbox (default: $PWD; unsynced work is pulled first; the workspace is preserved and `oc` restarts it). See openshell/README.md.
set -euo pipefail

REPO_DIR="${1:-$PWD}"
[[ -d "$REPO_DIR" ]] || {
  echo "ERROR: not a directory: $REPO_DIR" >&2
  exit 1
}
TOP="$(git -C "$REPO_DIR" rev-parse --show-toplevel 2>/dev/null)" || {
  echo "ERROR: not a git repository: $REPO_DIR (oc-sync needs git to carry commits back)" >&2
  exit 1
}

IFS=$'\t' read -r SANDBOX_NAME _ < <(opencode-sandbox --print "$TOP")

# The lock of oc: a running session keeps its sandbox, and unsynced work is pulled before the stop.
LOCK_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/oc-sync"
mkdir -p -- "$LOCK_DIR"
exec 9>"$LOCK_DIR/$SANDBOX_NAME.lock"
flock -n 9 || {
  echo "ERROR: another oc session is running for this repository" >&2
  exit 1
}
if ! OC_SYNC_LOCKED=1 oc-sync pull "$TOP"; then
  echo "ERROR: oc-sync pull failed; not stopping ${SANDBOX_NAME}, its unsynced work would be stranded" >&2
  exit 1
fi

exec openshell sandbox stop "$SANDBOX_NAME"
