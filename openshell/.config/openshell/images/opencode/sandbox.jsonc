// Sandbox-only opencode overrides, baked into the openshell-opencode image at /sandbox/opencode.jsonc.
// opencode merges them by ancestor discovery over the shared config, which is RO-bound at /sandbox/.config/opencode. See openshell/README.md.
{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    // The built-in provider is not redefined, only pointed at the profile's variable.
    "zai-coding-plan": {
      "env": ["ZAI_CODING_PLAN_API_KEY"],
      "settings": {
        "apiKey": "{env:ZAI_CODING_PLAN_API_KEY}"
      }
    }
  },
  "mcp": {
    "servers": {
      "MCP_DOCKER": {
        "type": "remote",
        "url": "http://host.openshell.internal:8811/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:MCP_GATEWAY_AUTH_TOKEN}"
        }
      }
    }
  }
}
