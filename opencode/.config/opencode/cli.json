{
  "$schema": "https://opencode.ai/v2/cli.json",
  "animations": true,
  "attention": {
    "notifications": true,
    "sound": false
  },
  "highlights": false,
  "keybinds": {
    "agent.cycle": "tab"
  },
  "prompt": {
    "image_preview": true
  },
  "scroll": {
    "acceleration": true
  },
  "session": {
    "grouping": "auto",
    "image_preview": true,
    "permissions": "prompt",
    "scrollbar": true,
    "thinking": "hide",
    "verbosity": "high"
  },
  "tabs": {
    "indicators": "status",
    "layout": "horizontal"
  },
  "theme": {
    "mode": "dark",
    "name": "catppuccin"
  }
}
