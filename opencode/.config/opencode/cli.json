{
  "$schema": "https://opencode.ai/v2/cli.json",
  "animations": true,
  "attention": {
    "notifications": true,
    "sound": false
  },
  "keybinds": {
    "agent.cycle": "tab"
  },
  "plugins": [
    "./herdr-opencode"
  ],
  "scroll": {
    "acceleration": true
  },
  "tabs": {
    "indicators": "status",
    "layout": "horizontal"
  },
  "theme": {
    "mode": "dark",
    "name": "catppuccin"
  }
}
