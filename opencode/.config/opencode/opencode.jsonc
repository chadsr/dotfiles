{
  "$schema": "https://opencode.ai/config.json",
  "websearch": false,
  "lsp": {
    // "basedpyright": {
    //   "command": [
    //     "basedpyright-langserver",
    //     "--stdio"
    //   ],
    //   "disabled": false,
    //   "extensions": [
    //     ".py",
    //     ".pyi"
    //   ]
    // },
    // "pyright": {
    //   "disabled": true
    // }
  },
  "mcp": {
    "servers": {
      "MCP_DOCKER": {
        "type": "remote",
        "url": "http://172.17.0.1:8811/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {file:/run/user/1000/docker-mcp-gateway/token}"
        }
      }
      // "debugmcp": {
      //   "type": "remote",
      //   "url": "http://localhost:3001/mcp"
      // }
    }
  },
  "model": "zai-coding-plan/glm-5.4",
  "permissions": [
    {
      "action": "external_directory",
      "effect": "ask",
      "resource": "*"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "/tmp/opencode/**"
    }
  ],
  "providers": {
    "zai-coding-plan": {
      "models": {
        "glm-5.4": {
          "settings": {
            "reasoningEffort": "high",
            "thinking": {
              "type": "enabled",
              "clear_thinking": false
            }
          }
        },
        "glm-5.3": {
          "settings": {
            "reasoningEffort": "max",
            "thinking": {
              "type": "enabled",
              "clear_thinking": false
            }
          }
        },
      }
    }
  },
  "update": "disable",
  "plugins": [
    "@tarquinen/opencode-dcp@latest"
  ]
}
