{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "basedpyright": {
      "command": [
        "basedpyright-langserver",
        "--stdio"
      ],
      "disabled": false,
      "extensions": [
        ".py",
        ".pyi"
      ]
    },
    "pyright": {
      "disabled": true
    }
  },
  "mcp": {
    "servers": {
      "MCP_DOCKER": {
        "command": [
          "docker",
          "mcp",
          "gateway",
          "run",
          "--profile",
          "dev-tools"
        ],
        "type": "local"
      },
      "debugmcp": {
        "type": "remote",
        "url": "http://localhost:3001/mcp"
      },
      "penpot": {
        "type": "remote",
        "url": "http://localhost:9001/mcp/stream"
      }
    }
  },
  "model": "zai-coding-plan/glm-5.3",
  "permissions": [
    {
      "action": "external_directory",
      "effect": "ask",
      "resource": "*"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "/tmp/opencode/*"
    }
  ],
  "providers": {
    "zai-coding-plan": {
      "models": {
        "glm-5.3": {
          "settings": {
            "reasoningEffort": "max",
            "thinking": {
              "type": "enabled",
              "clear_thinking": false
            }
          }
        }
      }
    }
  },
  "update": "disable",
  "plugins": [
    "@tarquinen/opencode-dcp@latest"
  ]
}
