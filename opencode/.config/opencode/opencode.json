{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "lsp": {
    "basedpyright": {
      "command": [
        "basedpyright-langserver",
        "--stdio"
      ],
      "disabled": false,
      "extensions": [
        ".py",
        ".pyi"
      ]
    },
    "pyright": {
      "disabled": true
    }
  },
  "mcp": {
    "MCP_DOCKER": {
      "command": [
        "docker",
        "mcp",
        "gateway",
        "run",
        "--profile",
        "dev-tools"
      ],
      "enabled": true,
      "type": "local"
    },
    "debugmcp": {
      "enabled": true,
      "type": "remote",
      "url": "http://localhost:3001/mcp"
    }
  },
  "model": "zai-coding-plan/glm-5.3",
  "plugin": [],
  "provider": {
    "zai-coding-plan": {
      "models": {
        "glm-5.3": {
          "options": {
            "reasoningEffort": "max"
          }
        }
      }
    }
  },
  "tools": {
    "write": true
  }
}
