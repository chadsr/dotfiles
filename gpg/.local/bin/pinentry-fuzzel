#!/usr/bin/env bash

# Initial handshake
echo "OK"

CR=$(printf '\r')
prompt=""

while read -r cmd rest; do
  rest=${rest%"$CR"}

  case "$cmd" in
  SETDESC | SETPROMPT | setdesc | setprompt)
    prompt=$rest
    echo "OK"
    ;;
  GETPIN | getpin)
    if ! pin_prog=$(command -v fuzzel); then
      echo "ERR 83886179 fuzzel not found" >&2
      echo "ERR 83886179 No pinentry program"
    else
      password=$(printf "" | "$pin_prog" --prompt-only "$prompt " --password --dmenu)

      if [ "$password" = "" ]; then
        # user cancelled
        echo "ERR 83886179 User canceled"
      else
        # send password back to gpg
        echo "D $password"
        echo "OK"
      fi
    fi
    ;;
  BYE | bye)
    echo "OK"
    exit 0
    ;;
  *)
    # For anything else, just respond OK
    echo "OK"
    ;;
  esac
done
