#!/usr/bin/env sh

# Initial handshake
echo "OK"

CR=$(printf '\r')
prompt=""

while read -r cmd rest; do
  rest=${rest%"$CR"}

  case "$cmd" in
  SETDESC | SETPROMPT | setdesc | setprompt)
    prompt=$rest
    echo "OK"
    ;;
  GETPIN | getpin)
    password=$(printf "" | "$(which fuzzel)" --prompt-only "$prompt " --password --dmenu)

    if [ "$password" = "" ]; then
      # user cancelled
      echo "ERR 83886179 User canceled"
    else
      # send password back to gpg
      echo "D $password"
      echo "OK"
    fi
    ;;
  BYE | bye)
    echo "OK"
    exit 0
    ;;
  *)
    # For anything else, just respond OK
    echo "OK"
    ;;
  esac
done
