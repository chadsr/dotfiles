#!/usr/bin/env bash
# gpg-forward-bootstrap <gpg-fp> <host>

set -euo pipefail

FORWARD_HOME=$HOME/.gnupg-forward

usage() {
  cat <<EOF
Usage: ${0##*/} <gpg-fp> <host>
        gpg --export -a <gpg-fp> | ssh -o ClearAllForwardings=yes -o ControlMaster=no -o ControlPath=none <host> ${0##*/}

Imports a public key from stdin into $FORWARD_HOME, the GNUPGHOME used for gpg-agent forwarding over ssh RemoteForward.
EOF
}

if [[ $# -eq 2 && $1 != -* && $2 != -* ]]; then
  # non-mux ssh must never carry the RemoteForward — it steals the master's socket
  gpg --export -a "$1" | ssh -o ClearAllForwardings=yes -o ControlMaster=no -o ControlPath=none "$2" "${0##*/}"

  # remote socket path is per-OS
  remote_sock=$(ssh -o ClearAllForwardings=yes -o ControlMaster=no -o ControlPath=none "$2" \
    'GNUPGHOME=$HOME/.gnupg-forward gpgconf --list-dir agent-socket')
  local_sock=$(gpgconf --list-dir agent-extra-socket)

  cat <<EOF

Add to ~/.ssh/config:

  Host $2
    RemoteForward $remote_sock $local_sock
EOF
  exit
fi

for arg in "$@"; do
  case $arg in
  -h | --help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
  esac
done

# no PTY over 'ssh host cmd'
[[ -t 0 ]] && {
  usage >&2
  exit 2
}
read -r -N 1 -t 2 first || {
  usage >&2
  exit 2
}

# leftover agent squats the socket
cleanup() {
  gpgconf --homedir "$FORWARD_HOME" --kill gpg-agent 2>/dev/null || true
}
trap cleanup EXIT

mkdir -p "$FORWARD_HOME"
chmod 700 "$FORWARD_HOME"
[[ -L $FORWARD_HOME/gpg.conf ]] || printf 'no-autostart\n' >"$FORWARD_HOME/gpg.conf"

# Linux socketdir; no-op on macOS
gpgconf --homedir "$FORWARD_HOME" --create-socketdir 2>/dev/null || true

{
  printf '%s' "$first"
  cat
} | gpg --homedir "$FORWARD_HOME" --import
