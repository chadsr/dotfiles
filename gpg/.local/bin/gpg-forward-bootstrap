#!/usr/bin/env bash
# gpg-forward-bootstrap <gpg-fp> <host>

set -euo pipefail

FORWARD_HOME=$HOME/.gnupg-forward

usage() {
  cat <<EOF
Usage: ${0##*/} <gpg-fp> <host>
        gpg --export -a <gpg-fp> | ssh -o ControlMaster=no -o ControlPath=none <host> ${0##*/}

Imports armored public key(s) from stdin into $FORWARD_HOME; the GNUPGHOME used for gpg-agent forwarding over ssh RemoteForward.
When run as <gpg-fp> <host>, also prints the RemoteForward line to add to this machine's ~/.ssh/config.
EOF
}

if [[ $# -eq 2 && $1 != -* && $2 != -* ]]; then
  gpg --export -a "$1" | ssh -o ControlMaster=no -o ControlPath=none "$2" "${0##*/}"

  # socket path gpg dials on the remote (per-OS)
  remote_sock=$(ssh -o ControlMaster=no -o ControlPath=none "$2" \
    'GNUPGHOME=$HOME/.gnupg-forward gpgconf --list-dir agent-socket')
  local_sock=$(gpgconf --list-dir agent-extra-socket)

  cat <<EOF

Done. Add to ~/.ssh/config on this machine:

  Host $2
    RemoteForward $remote_sock $local_sock

(the restricted extra socket: sign/decrypt work remotely, keys stay local)

Reconnect with a fresh connection (not an existing ControlMaster mux), then verify:

  ssh $2 'echo \$GNUPGHOME'              # -> /home/<user>/.gnupg-forward
  ssh $2 gpg --list-secret-keys          # -> keys from the workstation agent
EOF
  exit
fi

for arg in "$@"; do
  case $arg in
  -h | --help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
  esac
done

# no PTY over 'ssh host cmd', so -t 0 alone won't catch a bare remote run
[[ -t 0 ]] && {
  usage >&2
  exit 2
}
read -r -N 1 -t 2 first || {
  usage >&2
  exit 2
}

# a leftover agent squats the socket and breaks the RemoteForward bind
cleanup() {
  gpgconf --homedir "$FORWARD_HOME" --kill gpg-agent 2>/dev/null || true
}
trap cleanup EXIT

mkdir -p "$FORWARD_HOME"
chmod 700 "$FORWARD_HOME"
printf 'no-autostart\n' >"$FORWARD_HOME/gpg.conf"

# create the Linux socketdir gpg dials; no-op on macOS
gpgconf --homedir "$FORWARD_HOME" --create-socketdir 2>/dev/null || true

{
  printf '%s' "$first"
  cat
} | gpg --homedir "$FORWARD_HOME" --import
