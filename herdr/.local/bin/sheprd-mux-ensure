#!/usr/bin/env bash
# bootstrap a ControlMaster at an ssh host's configured path
set -u
umask 077

host=${1:-}
[ "$host" != "" ] || exit 0
# recursion guard
[ "${SHEPRD_MUX_ENSURE:-}" != 1 ] || exit 0
export SHEPRD_MUX_ENSURE=1

lastfail=${TMPDIR:-/tmp}/sheprd-mux-ensure.$host.lastfail

ssh -n -O check "$host" >/dev/null 2>&1 && exit 0

# one attempt per 30s per host
now=$(date +%s)
if [ -f "$lastfail" ]; then
  last=$(cat "$lastfail" 2>/dev/null || printf 0)
  [ $((now - last)) -ge 30 ] || exit 0
fi
printf '%s\n' "$now" >"$lastfail"

# detached, so as to not block the triggering ssh's config parse
ssh -fN -o BatchMode=yes -o ConnectTimeout=10 "$host" </dev/null >/dev/null 2>&1 &
exit 0
