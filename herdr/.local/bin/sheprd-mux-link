#!/usr/bin/env bash
# link the config ControlPath at sheprd's live mux masters so everything rides the one authenticated session
set -u

log() {
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"${TMPDIR:-/tmp}/sheprd-mux-link.log"
}

# emit "ctlpath host" per live master
masters() {
  pgrep -af 'ssh .*herdr-mux' 2>/dev/null |
    while IFS= read -r line; do
      ctl='' host='' is_master=''
      read -r -a argv <<<"$line"
      for ((i = 0; i < ${#argv[@]}; i++)); do
        case ${argv[i]} in
        ControlMaster=yes) is_master=1 ;;
        ControlPath=*) ctl=${argv[i]#ControlPath=} ;;
        --) ((i + 1 < ${#argv[@]})) && host=${argv[i + 1]} ;;
        esac
      done
      if [ "$is_master" != "" ] && [ "$ctl" != "" ] && [ "$host" != "" ]; then
        printf '%s %s\n' "$ctl" "$host"
      fi
    done |
    sort -u
}

# the ControlPath ssh resolves for host, or nothing
config_path() {
  local line
  line=$(ssh -n -G "$1" 2>/dev/null | grep -m1 '^controlpath ')
  printf '%s' "${line#controlpath }"
}

# link one master at the config's ControlPath
link() {
  local ctl=$1 host=$2 cfg
  # liveness: pgrep can race a master mid-death
  ssh -n -O check -o ControlPath="$ctl" "$host" >/dev/null 2>&1 || return 0
  cfg=$(config_path "$host")
  case $cfg in
  /*) ;;
  *) return 0 ;;
  esac
  # never replace a real file or socket
  [ -e "$cfg" ] && [ ! -L "$cfg" ] && return 0
  ln -sfn "$ctl" "$cfg" && log "linked: $cfg -> $ctl ($host)"
}

# drop our symlinks whose master socket is gone
cleanup() {
  local link
  for link in "$HOME"/.ssh/cm-*; do
    [ -L "$link" ] || continue
    [ -S "$link" ] || {
      rm -f "$link"
      log "cleaned: $link"
    }
  done
}

masters | while read -r ctl host; do
  link "$ctl" "$host"
done
cleanup
log "run done: pid $$"
