#!/usr/bin/env bash
# Logout action for wlogout/swaync

if [[ -n ${SWAYSOCK:-} ]] && command -v swaymsg >/dev/null 2>&1; then
  exec swaymsg exit
elif [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && command -v hyprctl >/dev/null 2>&1; then
  exec hyprctl dispatch exit 0
else
  exec loginctl terminate-session "${XDG_SESSION_ID:?XDG_SESSION_ID unset}"
fi
